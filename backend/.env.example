# --- Supabase -----------------------------------------------------------
# SUPABASE_URL and SUPABASE_ANON_KEY were injected automatically by the Edge
# Runtime and had to become explicit when the backend moved off it.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=
# All four default in code; set them only to pin a different model.
OPENAI_VISION_MODEL=
OPENAI_TEXT_EXTRACTION_MODEL=
OPENAI_SELECTION_MODEL=
OPENAI_EMBEDDING_MODEL=

# --- Feature flags ------------------------------------------------------
CATALOG_SEMANTIC_SEARCH_ENABLED=true

# --- Auth email webhook (send-email) ------------------------------------
# Supabase Auth -> Hooks -> Send Email. Must point at POST /send-email.
SEND_EMAIL_HOOK_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# --- Server -------------------------------------------------------------
PORT=8080

# --- CLI tooling only ---------------------------------------------------
BACKFILL_BATCH_SIZE=100
BACKFILL_ROUND_TIMEOUT_MS=120000
EVAL_MAX_CASES=
# Live eval targets the deployed Node backend rather than the Edge Function URL.
EVAL_BACKEND_URL=http://localhost:8080
EVAL_SUPABASE_URL=
EVAL_SUPABASE_PUBLISHABLE_KEY=
EVAL_USER_JWT=
LIVE_EVAL_ACK=
# Stamped onto a persisted eval run so a score can be traced back to a commit.
EVAL_PERSIST=
EVAL_GIT_REF=
