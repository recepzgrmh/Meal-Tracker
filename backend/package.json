{
  "name": "meal-clarity-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/cli/eval-deterministic.ts",
    "eval:live": "tsx src/cli/eval-live.ts",
    "backfill:embeddings": "tsx src/cli/backfill-embeddings.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "standardwebhooks": "^1.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
