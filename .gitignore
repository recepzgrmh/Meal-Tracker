# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Environment files & secrets
.env
*.env
.env.*
!.env.example
!backend/.env.example


# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/test/failures/

# Local dart-define files may contain environment-specific publishable keys.
/config/*.json
!/config/app_config.example.json

# Generated by flutterfire configure; regenerate locally instead of committing.
# firebase.json stays tracked: it holds only public project/app identifiers.
# The platform config files embed Google API keys, which the CI secret scan
# rejects, so they stay local. lib/firebase_options.dart is committed as a
# stub for CI and gets overwritten locally by flutterfire configure.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Local AI-tooling caches.
.hallmark/
**/.hallmark/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Catalog tooling: raw fetched source pages are a rebuildable local cache.
# Only promoted, hash-indexed snapshots under tool/catalog/snapshots/ are committed.
tool/catalog/.cache/

# Food database staging area (data/README.md). The datasets are large and most
# are not redistributable; only the provenance manifest and the folder skeleton
# are committed. Derived app data is promoted into assets/ instead.
/data/raw/**
/data/interim/**
/data/processed/**
# Re-include the directories themselves so git descends into them and can see
# the .gitkeep files that hold the folder skeleton in version control.
!/data/raw/**/
!/data/**/.gitkeep

# Derived pipeline archives are reproducible from the raw snapshots via the
# tool/food_import binaries and are far above hosting size limits; only the
# small metrics/validation JSON summaries stay in version control.
/data/**/*.jsonl.gz

# Installed dependencies are reproducible from the lockfiles next to them.
# tool/food_import/node_modules was committed by accident (149 files of pg and
# its transitive deps); it is removed from the index in the same change that
# adds this rule.
node_modules/

# Presentation deck & scripts
docs/loom-deck.html
docs/LOOM_SCRIPT.md
docs/SUBMISSION_EMAIL.md



