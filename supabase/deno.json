{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "tasks": {
    "check": "deno fmt --check functions && deno lint functions && deno check functions/analyze-meal/index.ts functions/commit-meal/index.ts functions/search-food-catalog/index.ts functions/send-email/index.ts",
    "test": "deno test functions/tests",
    "eval": "deno run --allow-read functions/evals/run_deterministic_eval.ts",
    "eval:live": "deno run --allow-env --allow-read --allow-net functions/evals/run_live_eval.ts",
    "backfill:embeddings": "deno run --allow-env --allow-net functions/tools/run_embedding_backfill.ts"
  }
}
