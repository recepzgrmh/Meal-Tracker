  "fixed_sql": [
    {
      "name": "local_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_profiles\" (\"user_id\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"locale\" TEXT NOT NULL DEFAULT 'tr-TR', \"timezone\" TEXT NOT NULL DEFAULT 'Europe/Istanbul', \"daily_calorie_target\" INTEGER NULL, \"primary_intention\" TEXT NULL, \"onboarding_version\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"user_id\"));"
        }
      ]
    },
    {
      "name": "local_meals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_meals\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"raw_input\" TEXT NULL, \"eaten_at\" INTEGER NOT NULL, \"image_asset\" TEXT NULL, \"sync_status\" TEXT NOT NULL DEFAULT 'synced', \"row_version\" INTEGER NOT NULL DEFAULT 1, \"local_updated_at\" INTEGER NOT NULL, \"remote_updated_at\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"user_id\", \"id\"));"
        }
      ]
    },
    {
      "name": "local_meal_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_meal_items\" (\"id\" TEXT NOT NULL, \"meal_id\" TEXT NOT NULL REFERENCES local_meals (id) ON DELETE CASCADE, \"user_id\" TEXT NOT NULL, \"food_id\" TEXT NULL, \"name\" TEXT NOT NULL, \"source_text\" TEXT NOT NULL, \"portion_label\" TEXT NOT NULL, \"grams\" REAL NOT NULL, \"calories_per100g\" REAL NOT NULL, \"protein_per100g\" REAL NOT NULL, \"carbs_per100g\" REAL NOT NULL, \"fat_per100g\" REAL NOT NULL, \"match_state\" TEXT NOT NULL, \"source_name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_operations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_operations\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"entity_type\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"operation_type\" TEXT NOT NULL, \"payload_json\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"attempt_count\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NULL, \"last_error_code\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_checkpoints",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_checkpoints\" (\"user_id\" TEXT NOT NULL, \"scope\" TEXT NOT NULL, \"cursor\" TEXT NULL, \"pulled_at\" INTEGER NOT NULL, PRIMARY KEY (\"user_id\", \"scope\"));"
        }
      ]
    },
    {
      "name": "app_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_preferences\" (\"user_id\" TEXT NOT NULL, \"key\" TEXT NOT NULL, \"value_json\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"user_id\", \"key\"));"
        }
      ]
    }
  ]
